{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["app", "src", "test", "tools", "*.ts"],
  // Deliberate portability violations, kept as data for tools/check-portability.ts
  // to be pointed at. They are inputs to a test, not code — typechecking them
  // would report exactly the problems they exist to contain.
  //
  // tools/bench/entry.ts is excluded for the same shape of reason: it imports the
  // *patched* copy of src/ that `pnpm bench` builds, which has setters this one
  // does not. It is typechecked — by `pnpm bench`, against the tree it actually
  // imports, with this same config extended.
  "exclude": ["test/fixtures", "tools/bench/entry.ts"]
}
