{
  "name": "aphelion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A game about swinging a spacecraft through gravity, where the only thing you do is decide when to let go",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "portable": "node tools/check-portability.ts",
    "replay": "node tools/replay.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm portable && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
